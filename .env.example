# Supabase project settings. Use the public/anon key only on the server in this app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-secret
OWNER_EMAIL=you@example.com

# Random secret used only by the Vercel daily cron endpoint.
CRON_SECRET=generate-a-long-random-value

# Optional: email alerts for newly detected official exam notices.
# Use a verified sender domain in Resend; leave unset for in-app-only alerts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Default official PIB releases feed; override only with the official PIB URL.
PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1
